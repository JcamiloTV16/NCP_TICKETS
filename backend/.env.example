# ========================================
# NCP Tickets Backend - Environment Config
# ========================================

# --- Base de Datos (Neon DB - PostgreSQL Serverless) ---
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# --- JWT ---
SECRET_KEY=genera-una-clave-secreta-segura-aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY_PATH=vapid_private.pem
VAPID_CLAIM_EMAIL=mailto:soporte@nuevocolegiodelprado.edu.co

# --- Email Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soporte@nuevocolegiodelprado.edu.co
SMTP_PASSWORD=tu-contrasena-de-aplicacion-google
SMTP_FROM_EMAIL=soporte@nuevocolegiodelprado.edu.co
SMTP_FROM_NAME="NCP Tickets - Inversiones Oeding"
SMTP_TLS=True
EMAIL_NOTIFICATIONS_ENABLED=True
